<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
	<class>MainWindow</class>
	<widget class="QMainWindow" name="MainWindow">
		<property name="geometry">
			<rect>
				<x>0</x>
				<y>0</y>
				<width>700</width>
				<height>600</height>
			</rect>
		</property>
		<property name="windowTitle">
			<string>点云地面坡度滤波系统</string>
		</property>
		<widget class="QWidget" name="centralwidget">
			<layout class="QVBoxLayout" name="verticalLayout">

				<!-- 文件选择区域 -->
				<item>
					<widget class="QGroupBox" name="groupBoxFile">
						<property name="title">
							<string>文件选择</string>
						</property>
						<layout class="QHBoxLayout" name="horizontalLayoutFile">
							<item>
								<widget class="QLineEdit" name="lineEditFile">
									<property name="placeholderText">
										<string>请选择点云文件...</string>
									</property>
									<property name="readOnly">
										<bool>true</bool>
									</property>
								</widget>
							</item>
							<item>
								<widget class="QPushButton" name="btnBrowse">
									<property name="text">
										<string>浏览...</string>
									</property>
								</widget>
							</item>
						</layout>
					</widget>
				</item>

				<!-- 参数设置区域 -->
				<item>
					<widget class="QGroupBox" name="groupBoxParams">
						<property name="title">
							<string>滤波参数</string>
						</property>
						<layout class="QGridLayout" name="gridLayoutParams">

							<item row="0" column="0">
								<widget class="QLabel" name="labelXStep">
									<property name="text">
										<string>格网边长 X (m):</string>
									</property>
								</widget>
							</item>
							<item row="0" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxXStep">
									<property name="value">
										<double>1.0</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>100.0</double>
									</property>
									<property name="singleStep">
										<double>0.1</double>
									</property>
								</widget>
							</item>

							<item row="1" column="0">
								<widget class="QLabel" name="labelYStep">
									<property name="text">
										<string>格网边长 Y (m):</string>
									</property>
								</widget>
							</item>
							<item row="1" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxYStep">
									<property name="value">
										<double>1.0</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>100.0</double>
									</property>
									<property name="singleStep">
										<double>0.1</double>
									</property>
								</widget>
							</item>

							<item row="2" column="0">
								<widget class="QLabel" name="labelThreshold">
									<property name="text">
										<string>坡度阈值:</string>
									</property>
								</widget>
							</item>
							<item row="2" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxThreshold">
									<property name="value">
										<double>0.1</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>1.0</double>
									</property>
									<property name="singleStep">
										<double>0.01</double>
									</property>
									<property name="decimals">
										<number>2</number>
									</property>
								</widget>
							</item>

							<item row="3" column="0">
								<widget class="QLabel" name="labelHeightThreshold">
									<property name="text">
										<string>高度阈值 (m):</string>
									</property>
								</widget>
							</item>
							<item row="3" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxHeightThreshold">
									<property name="value">
										<double>0.5</double>
									</property>
									<property name="minimum">
										<double>0.1</double>
									</property>
									<property name="maximum">
										<double>5.0</double>
									</property>
									<property name="singleStep">
										<double>0.1</double>
									</property>
									<property name="decimals">
										<number>2</number>
									</property>
									<property name="toolTip">
										<string>高于全局最低点此高度的点直接判为非地面</string>
									</property>
								</widget>
							</item>

							<item row="4" column="0">
								<widget class="QLabel" name="labelMethod">
									<property name="text">
										<string>坡度计算方式:</string>
									</property>
								</widget>
							</item>
							<item row="4" column="1">
								<widget class="QComboBox" name="comboBoxMethod">
									<item>
										<property name="text">
											<string>平均</string>
										</property>
									</item>
									<item>
										<property name="text">
											<string>最小</string>
										</property>
									</item>
									<item>
										<property name="text">
											<string>中值</string>
										</property>
									</item>
								</widget>
							</item>

							<item row="5" column="0">
								<widget class="QLabel" name="labelNeighborhood">
									<property name="text">
										<string>邻域范围:</string>
									</property>
								</widget>
							</item>
							<item row="5" column="1">
								<widget class="QComboBox" name="comboBoxNeighborhood">
									<item>
										<property name="text">
											<string>3x3</string>
										</property>
									</item>
									<item>
										<property name="text">
											<string>5x5</string>
										</property>
									</item>
								</widget>
							</item>

							<item row="6" column="0" colspan="2">
								<widget class="QCheckBox" name="checkBoxAdaptive">
									<property name="text">
										<string>使用动态阈值</string>
									</property>
								</widget>
							</item>

							<item row="7" column="0">
								<widget class="QLabel" name="labelFilterMethod">
									<property name="text">
										<string>滤波方法:</string>
									</property>
								</widget>
							</item>
							<item row="7" column="1">
								<widget class="QComboBox" name="comboBoxFilterMethod">
									<item>
										<property name="text">
											<string>坡度滤波</string>
										</property>
									</item>
									<item>
										<property name="text">
											<string>CSF布料模拟</string>
										</property>
									</item>
								</widget>
							</item>

							<item row="8" column="0">
								<widget class="QLabel" name="labelCSFResolution">
									<property name="text">
										<string>CSF 布料分辨率 (m):</string>
									</property>
								</widget>
							</item>
							<item row="8" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxCSFResolution">
									<property name="value">
										<double>1.0</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>50.0</double>
									</property>
									<property name="singleStep">
										<double>0.1</double>
									</property>
								</widget>
							</item>

							<item row="9" column="0">
								<widget class="QLabel" name="labelCSFMaxIter">
									<property name="text">
										<string>CSF 最大迭代次数:</string>
									</property>
								</widget>
							</item>
							<item row="9" column="1">
								<widget class="QSpinBox" name="spinBoxCSFMaxIter">
									<property name="value">
										<number>500</number>
									</property>
									<property name="minimum">
										<number>1</number>
									</property>
									<property name="maximum">
										<number>10000</number>
									</property>
									<property name="singleStep">
										<number>50</number>
									</property>
								</widget>
							</item>

							<item row="10" column="0">
								<widget class="QLabel" name="labelCSFThreshold">
									<property name="text">
										<string>CSF 分类阈值 (m):</string>
									</property>
								</widget>
							</item>
							<item row="10" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxCSFThreshold">
									<property name="value">
										<double>0.5</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>5.0</double>
									</property>
									<property name="singleStep">
										<double>0.05</double>
									</property>
									<property name="decimals">
										<number>2</number>
									</property>
								</widget>
							</item>

							<item row="11" column="0">
								<widget class="QLabel" name="labelCSFRigidness">
									<property name="text">
										<string>CSF 布料硬度:</string>
									</property>
								</widget>
							</item>
							<item row="11" column="1">
								<widget class="QSpinBox" name="spinBoxCSFRigidness">
									<property name="value">
										<number>3</number>
									</property>
									<property name="minimum">
										<number>1</number>
									</property>
									<property name="maximum">
										<number>3</number>
									</property>
								</widget>
							</item>

							<item row="12" column="0">
								<widget class="QLabel" name="labelCSFTimeStep">
									<property name="text">
										<string>CSF 时间步长:</string>
									</property>
								</widget>
							</item>
							<item row="12" column="1">
								<widget class="QDoubleSpinBox" name="doubleSpinBoxCSFTimeStep">
									<property name="value">
										<double>0.65</double>
									</property>
									<property name="minimum">
										<double>0.01</double>
									</property>
									<property name="maximum">
										<double>2.0</double>
									</property>
									<property name="singleStep">
										<double>0.05</double>
									</property>
									<property name="decimals">
										<number>2</number>
									</property>
								</widget>
							</item>

						</layout>
					</widget>
				</item>

				<!-- 操作按钮 -->
				<item>
					<layout class="QHBoxLayout" name="horizontalLayoutButtons">
						<item>
							<widget class="QPushButton" name="btnStart">
								<property name="text">
									<string>开始滤波</string>
								</property>
							</widget>
						</item>
						<item>
							<widget class="QPushButton" name="btnReset">
								<property name="text">
									<string>重置参数</string>
								</property>
							</widget>
						</item>
						<item>
							<widget class="QPushButton" name="btnExport">
								<property name="text">
									<string>导出结果</string>
								</property>
							</widget>
						</item>
					</layout>
				</item>

				<!-- 进度条 -->
				<item>
					<widget class="QProgressBar" name="progressBar">
						<property name="value">
							<number>0</number>
						</property>
					</widget>
				</item>

				<!-- 日志区域 -->
				<item>
					<widget class="QGroupBox" name="groupBoxLog">
						<property name="title">
							<string>状态日志</string>
						</property>
						<layout class="QVBoxLayout" name="verticalLayoutLog">
							<item>
								<widget class="QTextEdit" name="textEditLog">
									<property name="readOnly">
										<bool>true</bool>
									</property>
								</widget>
							</item>
						</layout>
					</widget>
				</item>

			</layout>
		</widget>
	</widget>
	<resources/>
	<connections/>
</ui>